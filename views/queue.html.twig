{% extends "layout.html.twig" %}

{% from 'macros.twig' import bytesToSize %}

{% set page_title = 'Queue' %}

{% block content %}
        {% for queue in pending|filter(v => v.changeRequested == 0) %}
            {% if loop.first %}
    <form action="{{ url_for('queue') }}" id="queue">
            {% endif %}
        <div class="mb-3 pb-3 asset" id="file_{{ queue.asset.id }}">
            <div class="row mb-3">
                <div class="col me-3 position-relative file-info">
                    <h3>File Information</h3>
                    <canvas class="file-preview position-absolute" width="512" height="512" id="preview_{{ queue.asset.id }}"></canvas>
                    <div class="file-metadata">
                        <p>
                            <strong>Filename:</strong><br>
                            <span class="file-name font-monospace bg-dark-subtle p-1">{{ queue.asset.filename | escape }}</span>
                        </p>
                        <p>
                            <strong>File size:</strong> {{ bytesToSize(queue.asset.fileSize) }}
                        </p>
                    </div>
                </div>
                <div class="col">
                    <h3>Source Information</h3>
                    <p>
                        <strong>Author Name:</strong><br>
                        <span>{{ queue.asset.author | escape }}</span>
                    </p>
                    {% if queue.asset.sourceUrl %}
                    <p>
                        <strong>Source URL:</strong><br>
                        <span><a href="{{ queue.asset.sourceUrl | escape('html_attr') }}">{{ queue.asset.sourceUrl | escape }}</a></span>
                    </p>
                    {% endif %}
                </div>
                <div class="col">
                    <h3>Uploader Information</h3>
                    <p>
                        <strong>Uploader:</strong><br>
                        {{ queue.asset.username }} ({{ queue.asset.bzid }})
                    </p>
                </div>
            </div>
            <div class="row d-none asset-error" id="file_errors_{{ queue.asset.id }}">
                <div class="col text-danger-emphasis">
                    <strong>Errors:</strong><br>
                    <ul></ul>
                </div>
            </div>
            <div class="row">
                <div class="col">
                    <h3>License Information</h3>
                    <p>
                        <strong>License Name:</strong><br>
                        <span>{{ queue.asset.licenseDisplayName | escape }}</span>
                    <p>

                    {% if queue.asset.licenseUrl %}
                    <p>
                        <strong>License URL:</strong><br>
                        <span><a href="{{ queue.asset.licenseUrl | escape('html_attr') }}" target="_blank" rel="noreferrer">{{ queue.asset.licenseUrl | escape }}</a></span>
                    </p>
                    {% endif %}
                    {% if queue.asset.licenseText %}
                    <p>
                        <strong>License Text:</strong><br>
                        <code><pre class="pre-wrap">{{ queue.asset.licenseText | escape}}</pre></code>
                    </p>
                    {% endif %}
                </div>
            </div>

            {% if queue.details %}
            <div class="row mb-3 ms-3 border-start border-4 border-danger">
                <div class="col">
                    <h3>Changes Requested</h3>
                    {{ queue.details|escape|nl2br }}
                </div>
            </div>
            {% endif %}

            <div class="row">
                <div class="col">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input review-action" type="radio" name="review[{{ queue.asset.id }}][action]" id="review_{{ queue.asset.id }}_nothing" value="" checked>
                        <label class="form-check-label" for="review_{{ queue.asset.id }}_nothing">Do Nothing</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input review-action" type="radio" name="review[{{ queue.asset.id }}][action]" id="review_{{ queue.asset.id }}_approve" value="approve">
                        <label class="form-check-label text-success-emphasis" for="review_{{ queue.asset.id }}_approve"><strong>Approve</strong></label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input review-action" type="radio" name="review[{{ queue.asset.id }}][action]" id="review_{{ queue.asset.id }}_request" value="request">
                        <label class="form-check-label text-warning" for="review_{{ queue.asset.id }}_request">Request Changes</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input review-action" type="radio" name="review[{{ queue.asset.id }}][action]" id="review_{{ queue.asset.id }}_reject" value="reject">
                        <label class="form-check-label text-danger-emphasis" for="review_{{ queue.asset.id }}_reject">Reject</label>
                    </div>
                </div>
            </div>
            <div class="row d-none review-details mt-3">
                <div class="col">
                    <label class="form-label" for="review_{{ queue.asset.id }}_details">Request/Rejection Details:</label>
                    <textarea class="form-control" id="review_{{ queue.asset.id }}_details" name="review[{{ queue.asset.id }}][details]" rows="8">{{ queue.details|escape|nl2br }}</textarea>
                </div>
            </div>

            <hr>
        </div>
            {% if loop.last %}
        <div class="row">
            <div class="col">
                <button type="submit" class="btn btn-primary mt-3">Submit Reviews</button>
            </div>
        </div>
    </form>
            {% endif %}
        {% else %}
            There are no files in the approval queue.
        {% endfor %}
{% endblock %}

{% block scripts %}
<script src="{{ base_path() }}/js/util.js"></script>
<script src="{{ base_path() }}/js/queue.js"></script>
<script>
{% for queue in pending|filter(v => v.changeRequested == 0 and v.asset.mimeType starts with 'image/') %}
    previewImage(document.getElementById('preview_{{ queue.asset.id }}'), '{{ url_for('view', {'bzid': queue.asset.bzid, 'queueid': queue.asset.id, width: 256, height: 256}) | escape('js') }}');
{% endfor %}
</script>
{% endblock %}
